import JSProofs.ReactBeforeMutation
import JSProofs.ReactSelection

/-!
# The before-mutation pass with its callees (zippy docs/react-proofs.md)

`cbm_full`: `cbm_spec` with `hasSelectionCapabilities` discharged by `ReactSelection.hsc_spec` and the walk's
`commitBeforeMutationEffects_complete` by `cbmc_root`, at the call states (generated by
`tools/react_commit/gen_cbm_full.py`). `getActiveElementDeep` stays a contract (`hGDC`).
-/

open ES ES.M HostRuns Logic
open Std (HashMap)

namespace ReactBeforeMutation

section
variable {eng : Engine} {σ : Type} {answer : HostAnswer σ}

set_option maxRecDepth 40000 in
set_option maxHeartbeats 8000000 in
theorem cbm_full {n : Nat}
    {h : σ}
    {fo : ObjId}
    {d : FuncData}
    {t : Value}
    {s : State}
    {bG : HashMap JSStr Binding}
    {oG : Option EnvId}
    {bdEv : Binding}
    {bdEn : Binding}
    {bdGD : Binding}
    {bdHS : Binding}
    {bdSI : Binding}
    {bdNE : Binding}
    {bdCC : Binding}
    {bdAV : Binding}
    {FR : ObjId}
    {R : ObjId}
    {Cont : ObjId}
    {E : ObjId}
    {Rc : ObjId}
    {K : ObjId}
    {fGD : ObjId}
    {fHS : ObjId}
    {fCC : ObjId}
    {ev0 : Value}
    {lanes : F64}
    {sf : F64}
    {cw : Bool}
    {ce : Bool}
    {cc : Bool}
    {aw : Bool}
    {ae : Bool}
    {ac : Bool}
    {tw : Bool}
    {te : Bool}
    {tc : Bool}
    {kw : Bool}
    {ke : Bool}
    {kc : Bool}
    {sw : Bool}
    {se : Bool}
    {sc : Bool}
    (hlt : fo < s.heap.size)
    (hk : (s.objEntry fo).kind = .func d)
    (hcode : d.code = CBMGen.commitBeforeMutationEffects_func)
    (hcls : d.isClassCtor = false)
    (hmode : d.thisMode = .strict)
    (hG : d.env < s.envs.size)
    (hGe : Scope.declLike? (s.envEntry d.env) = some (bG, oG))
    (hGEv : bG[JSStr.ofString "eventsEnabled"]? = some bdEv)
    (hGEvm : bdEv.mutable = true)
    (hGEvi : bdEv.value.isSome = true)
    (hGEn : bG[JSStr.ofString "_enabled"]? = some bdEn)
    (hGEnv : bdEn.value = some ev0)
    (hGEnm : bdEn.mutable = true)
    (hGGD : bG[JSStr.ofString "getActiveElementDeep"]? = some bdGD)
    (hGGDv : bdGD.value = some (.obj fGD))
    (hGHS : bG[JSStr.ofString "hasSelectionCapabilities"]? = some bdHS)
    (hGHSv : bdHS.value = some (.obj fHS))
    (hGSI : bG[JSStr.ofString "selectionInformation"]? = some bdSI)
    (hGSIm : bdSI.mutable = true)
    (hGSIi : bdSI.value.isSome = true)
    (hGNE : bG[JSStr.ofString "nextEffect"]? = some bdNE)
    (hGNEm : bdNE.mutable = true)
    (hGNEi : bdNE.value.isSome = true)
    (hGCC : bG[JSStr.ofString "commitBeforeMutationEffects_complete"]? = some bdCC)
    (hGCCv : bdCC.value = some (.obj fCC))
    (hGAV : bG[JSStr.ofString "appearingViewTransitions"]? = some bdAV)
    (hGAVm : bdAV.mutable = true)
    (hGAVi : bdAV.value.isSome = true)
    (hFR : FR < s.heap.size)
    (hFRk : (s.objEntry FR).kind.isPlain = true)
    (hFRc : (s.objEntry FR).props.get? (.str (JSStr.ofString "containerInfo")) = some (.data (.obj Cont) cw ce cc))
    (hR : R < s.heap.size)
    (hRk : (s.objEntry R).kind.isPlain = true)
    (hRa : (s.objEntry R).props.get? (.str (JSStr.ofString "alternate")) = some (.data (.obj Rc) aw ae ac))
    (hRt : (s.objEntry R).props.get? (.str (JSStr.ofString "tag")) =
      some (.data (.num (F64.fin false 6755399441055744 (-51))) tw te tc))
    (hRc : (s.objEntry R).props.get? (.str (JSStr.ofString "child")) = some (.data (.obj K) kw ke kc))
    (hRs : (s.objEntry R).props.get? (.str (JSStr.ofString "subtreeFlags")) = some (.data (.num sf) sw se sc))
    (hsf : isStrictlyEqual (.num (F64.fin false 0 (-1074)))
      (.num (numberBinOp .bitAnd sf (F64.fin false 4503599627370496 (-42)))) = true)
    (hlanes : isStrictlyEqual (.num (numberBinOp .bitAnd lanes (F64.fin false 5629495239245824 (-24)))) (.num lanes) = false)
    (hGDo : fGD < s.heap.size)
    (hGDc : ∃ dd, (s.objEntry fGD).kind = .func dd)
    (hHSo : fHS < s.heap.size)
    (hCCo : fCC < s.heap.size)
    (hGDC : ∀ w h1, Frame (FB d.env) s w → 200 ≤ w.fuel →
      WP eng answer (n + 1) h1 (callImpl eng (.obj fGD) .undefined #[.obj Cont]) w fun v w' h' =>
        v = .obj E ∧ Frame {} w w' ∧ w.fuel ≤ w'.fuel + 200 ∧ h' = h1)
    {S_d : FuncData}
    {S_fTL : ObjId}
    {S_bdTL : BuiltinData}
    {S_nm : JSStr}
    {S_ce : JSStr}
    (S_hk : (s.objEntry fHS).kind = .func S_d)
    (S_hcode : S_d.code = HSCGen.hasSelectionCapabilities_func)
    (S_hcls : S_d.isClassCtor = false)
    (S_hmode : S_d.thisMode = .strict)
    (S_hNN : ReactHostContainer.DomRead eng answer n s (FB d.env) E "nodeName" (.str S_nm))
    (S_hnm : S_nm.isEmpty = false)
    (S_hTL : ∀ w, Frame (FB d.env) s w → StrGets w S_nm (JSStr.ofString "toLowerCase") fun v => v = .obj S_fTL)
    (S_hTLo : S_fTL < s.heap.size)
    (S_hTLk : (s.objEntry S_fTL).kind = .builtin S_bdTL)
    (S_hTLfn : eng.builtins[S_bdTL.id]? = some (ES.Builtins.Text.stringCase true "toLowerCase"))
    (S_hlnm : (Unicode.toLower S_nm).isEmpty = false)
    (S_hin : isStrictlyEqual (.str (JSStr.ofString "input")) (.str (Unicode.toLower S_nm)) = false)
    (S_hta : isStrictlyEqual (.str (JSStr.ofString "textarea")) (.str (Unicode.toLower S_nm)) = false)
    (S_hCE : ReactHostContainer.DomRead eng answer n s (FB d.env) E "contentEditable" (.str S_ce))
    (S_hce : isStrictlyEqual (.str (JSStr.ofString "true")) (.str S_ce) = false)
    {C_d : FuncData}
    {C_av : Value}
    {C_fl : F64}
    {C_aw : Bool}
    {C_ae : Bool}
    {C_ac : Bool}
    {C_fw : Bool}
    {C_fe : Bool}
    {C_fc : Bool}
    {C_tw : Bool}
    {C_te : Bool}
    {C_tc : Bool}
    {C_sw : Bool}
    {C_se : Bool}
    {C_sc : Bool}
    {C_rw : Bool}
    {C_re : Bool}
    {C_rc : Bool}
    (C_hk : (s.objEntry fCC).kind = .func C_d)
    (C_hcode : C_d.code = CBMCGen.commitBeforeMutationEffects_complete_func)
    (C_hcls : C_d.isClassCtor = false)
    (C_hmode : C_d.thisMode = .strict)
    (C_hR : R < s.heap.size)
    (C_hRk : (s.objEntry R).kind.isPlain = true)
    (C_hRa : (s.objEntry R).props.get? (.str (JSStr.ofString "alternate")) = some (.data C_av C_aw C_ae C_ac))
    (C_hRf : (s.objEntry R).props.get? (.str (JSStr.ofString "flags")) = some (.data (.num C_fl) C_fw C_fe C_fc))
    (C_hRt : (s.objEntry R).props.get? (.str (JSStr.ofString "tag")) =
      some (.data (.num (F64.fin false 6755399441055744 (-51))) C_tw C_te C_tc))
    (C_hRs : (s.objEntry R).props.get? (.str (JSStr.ofString "sibling")) = some (.data .null C_sw C_se C_sc))
    (C_hRr : (s.objEntry R).props.get? (.str (JSStr.ofString "return")) = some (.data .null C_rw C_re C_rc))
    (C_h1024 : numberBinOp .bitAnd C_fl (F64.fin false 4503599627370496 (-42)) = F64.fin false 0 (-1074))
    (hf : 1200 ≤ s.fuel)
    (C_hdenv : C_d.env = d.env) :
    WP eng answer (n + 2) h (callImpl eng (.obj fo) t #[.obj FR, .obj R, .num lanes]) s fun v w h' =>
      v = .undefined ∧ h' = h ∧ Frame (FB d.env) s w := by
  refine cbm_spec (fo := fo) (d := d) (t := t) (bG := bG) (oG := oG) (bdEv := bdEv) (bdEn := bdEn) (bdGD := bdGD) (bdHS := bdHS) (bdSI := bdSI) (bdNE := bdNE) (bdCC := bdCC) (bdAV := bdAV) (FR := FR) (R := R) (Cont := Cont) (E := E) (Rc := Rc) (K := K) (fGD := fGD) (fHS := fHS) (fCC := fCC) (ev0 := ev0) (lanes := lanes) (sf := sf) (cw := cw) (ce := ce) (cc := cc) (aw := aw) (ae := ae) (ac := ac) (tw := tw) (te := te) (tc := tc) (kw := kw) (ke := ke) (kc := kc) (sw := sw) (se := se) (sc := sc) (hlt := hlt) (hk := hk) (hcode := hcode) (hcls := hcls) (hmode := hmode) (hG := hG) (hGe := hGe) (hGEv := hGEv) (hGEvm := hGEvm) (hGEvi := hGEvi) (hGEn := hGEn) (hGEnv := hGEnv) (hGEnm := hGEnm) (hGGD := hGGD) (hGGDv := hGGDv) (hGHS := hGHS) (hGHSv := hGHSv) (hGSI := hGSI) (hGSIm := hGSIm) (hGSIi := hGSIi) (hGNE := hGNE) (hGNEm := hGNEm) (hGNEi := hGNEi) (hGCC := hGCC) (hGCCv := hGCCv) (hGAV := hGAV) (hGAVm := hGAVm) (hGAVi := hGAVi) (hFR := hFR) (hFRk := hFRk) (hFRc := hFRc) (hR := hR) (hRk := hRk) (hRa := hRa) (hRt := hRt) (hRc := hRc) (hRs := hRs) (hsf := hsf) (hlanes := hlanes) (hGDo := hGDo) (hGDc := hGDc) (hHSo := hHSo) (hCCo := hCCo) (hGDC := hGDC) (hf := by omega) (hHSc := ⟨_, S_hk⟩) (hCCc := ⟨_, C_hk⟩) (hHSC := ?hHSC) (hCCC := ?hCCC)
  case hHSC =>
    intro w h1 hw hfw
    apply ReactSelection.hsc_spec (s := w) (fo := fHS) (t := .undefined) (E := E) (d := S_d) (fTL := S_fTL) (bdTL := S_bdTL) (nm := S_nm) (ce := S_ce)
      (hf := by omega) (hlt := lt_heap_of_frame hw hHSo) (hNN := fun w' h1 hw' => S_hNN w' h1 (frame_then_empty hw hw')) (hTL := fun w' hw' => S_hTL w' (frame_then_empty hw hw')) (hCE := fun w' h1 hw' => S_hCE w' h1 (frame_then_empty hw hw'))
    all_goals rebase_tac hw
  case hCCC =>
    intro w h1 hw hfw hN
    obtain ⟨bw, hdw, hbw⟩ := declLike_frame hw hG hGe
    obtain ⟨bd, hbd, hbv, hbm⟩ := hN bw oG hdw
    refine wp_mono (Q := fun v w' h' => v = .undefined ∧ w.fuel ≤ w'.fuel + 200 ∧ h' = h1 ∧
      Frame ⟨[(C_d.env, JSStr.ofString "nextEffect")], [], false⟩ w w' ∧
      ∃ bm, Scope.declLike? (w'.envEntry C_d.env) = some (bm, oG) ∧
        (∃ bd, bm[JSStr.ofString "nextEffect"]? = some bd ∧ bd.value = some .null) ∧
        ∀ x, x ≠ JSStr.ofString "nextEffect" → bm[x]? = bw[x]?) ?_ ?_
    · apply cbmc_root (s := w) (fo := fCC) (t := .undefined) (R := R) (bG := bw) (oG := oG) (bdN := bd) (d := C_d) (av := C_av) (fl := C_fl) (aw := C_aw) (ae := C_ae) (ac := C_ac) (fw := C_fw) (fe := C_fe) (fc := C_fc) (tw := C_tw) (te := C_te) (tc := C_tc) (sw := C_sw) (se := C_se) (sc := C_sc) (rw := C_rw) (re := C_re) (rc := C_rc)
        (hf := hfw) (hlt := lt_heap_of_frame hw hCCo) (hG := by rw [C_hdenv]; exact lt_envs_of_frame hw hG)
        (hGe := by rw [C_hdenv]; exact hdw) (hGN := hbd) (hGNv := hbv) (hGNm := hbm)
      all_goals rebase_tac hw
    · rintro v w' h' ⟨rfl, hfu, rfl, hF, bm, hd', ⟨bd', hb', hv'⟩, -⟩
      rw [C_hdenv] at hF hd'
      refine ⟨rfl, hfu, rfl, hF, frame_then_sub hw hF (fun p hp => by simp at hp; simp [hp, FB]) rfl rfl, ?_⟩
      intro bm' o' hd''
      rw [hd'] at hd''
      cases hd''
      exact ⟨bd', hb', hv'⟩

end

end ReactBeforeMutation
