import JSProofs.FactsCompose
import JSProofs.ReactSpawned
import JSProofs.ReactSpawnedCallees
import JSProofs.ReactNoEffects
import JSProofs.ReactEnsureCall

/-! flushSpawnedWork with its small callees, composed in Lean (`ReactSpawnedFull.fsp_full`, generated by
`gen_fsp_full.py`): releaseRootPooledCache, lanesToEventPriority, flushPendingEffects, flushSyncWorkAcrossRoots_impl
and ensureRootIsScheduled by their specs; requestPaint (the scheduler's) stays a contract. -/

facts_form ReactSpawned.fsp_spec
facts_form ReactSpawnedCallees.rrp_spec
facts_form ReactSpawnedCallees.ltep_sync
facts_form ReactSpawnedCallees.fsw_flushing
facts_form ReactNoEffects.pending_none
facts_form ReactEnsureCall.en_call

namespace ReactSpawned
open ES Logic

facts_compose fsp_comp := fsp_spec (n := n + 2) (K := 60) (fpE := ReactEnsureCall.fpEn d.env)
  | hRel => ReactSpawnedCallees.rrp_spec by
      rintro v w' h' ⟨hF, hfu, rfl⟩
      exact ⟨hF, frame_mono (frame_trans ‹Frame (FP1 _ _) _ _› hF)
        (fun p hp => by simpa [FPA, FP1, FPS, Footprint.union] using hp)
        (fun p hp => by simpa [FPA, FP1, FPS, Footprint.union] using hp) (fun hj => by simp [FPA, FP1, FPS, Footprint.union]),
        by omega, rfl⟩
  | hLP => ReactSpawnedCallees.ltep_sync by
      rintro v w' h' ⟨-, hF, hfu, rfl⟩
      exact ⟨hF, by omega, rfl⟩
  | hPE => ReactNoEffects.pending_none with u_d.env = d.env by
      rintro v w' h' ⟨-, hF, hfu, rfl⟩
      exact ⟨hF, hfu, rfl⟩
  | hFSs => ReactSpawnedCallees.fsw_flushing with u_d.env = d.env by
      rintro v w' h' ⟨hF, hfu, rfl⟩
      exact ⟨hF, by omega, rfl⟩
  | hEn => ReactEnsureCall.en_call (oG := oG) with u_d.env = d.env by
      have he := hob.2
      rintro v w' h' ⟨-, hF, hfu, rfl, hSc⟩
      rw [he] at hF hSc
      exact ⟨hF, frame_trans ‹Frame (FPA _ _ _) _ _› hF, by omega, rfl, hSc⟩

end ReactSpawned
