import JSProofs.ReactClickFacts
import JSProofs.QueueJob
import JSProofs.ReactSetState

/-!
# `setN(v)` for a click: React's code from the hook's setter to the queued microtask (zippy docs/react-proofs.md)

`dispatchSetState(fiber, queue, v)` in the counter's steady state, every React function on the way proved
(`ReactSetState.click` with `ReactScheduleClick` for `scheduleUpdateOnFiber` and `ReactEntangle` for
`entangleTransitionUpdate`). One hypothesis is left, about the host: `queueMicrotask(c)` with a callable `c` queues
the job `c()` and writes nothing else (`hQ`; Zippy's Lean engine does exactly this: `LeanBindings.engineOp`). The
result (`Done`): the job queue is the old one with React's callback appended, the callback is React's closure over the
module, the root is scheduled with the lane recorded, and only `fpClick` was written.
-/

open ES HostRuns Logic ReactClickFacts
open Std (HashMap)

namespace ReactClick

/-- What `enqueueConcurrentHookUpdate` writes (the module's queue, the fibers' lanes). -/
def fpH (e : EnvId) (A F Alt : ObjId) : Footprint :=
  ⟨[(e, "concurrentQueuesIndex"), (e, "concurrentlyUpdatedLanes")],
   [(A, .str "0"), (A, .str "1"), (A, .str "2"), (A, .str "3"), (F, .str "lanes"), (Alt, .str "lanes")], false⟩

/-- What a click's `setN(v)` writes: the update queued, the root's lanes, the schedule; and one job. -/
def fpClick (e : EnvId) (A F Alt Root : ObjId) : Footprint :=
  ⟨(fpH e A F Alt).binds ++ (ReactScheduleClick.fpAll Root e).binds,
   (fpH e A F Alt).props ++ (ReactScheduleClick.fpAll Root e).props, true⟩

/-- After `setN(v)`, from `s`: one job queued, React's callback `c`; the root scheduled, its lane recorded. -/
def Done (s w : State) (e : EnvId) (oG : Option EnvId) (Root : ObjId) (lanes : F64) (pe pc : Bool) (fp : Footprint) :
    Prop :=
  ∃ c ce, w.jobs = s.jobs.push (.obj c, #[]) ∧ ReactSchedTask.Callback w c ce e ∧
    ReactEnsureRoot.Scheduled w e oG Root ∧ e < w.envs.size ∧ Root < w.heap.size ∧
    (w.objEntry Root).props.get? (.str "pendingLanes") = some (.data (.num lanes) true pe pc) ∧ Frame fp s w

theorem done_bare {s w w' : State} {e : EnvId} {oG : Option EnvId} {Root : ObjId} {lanes : F64} {pe pc : Bool}
    {fp : Footprint} (hfj : fp.jobs = true) (h : Done s w e oG Root lanes pe pc fp) (hF : Frame {} w w') :
    Done s w' e oG Root lanes pe pc fp := by
  obtain ⟨c, ce, hj, hcb, hsch, he, hR, hpend, hfr⟩ := h
  refine ⟨c, ce, by rw [hF.jobs_eq rfl, hj], callback_bare hF rfl rfl hcb, scheduled_bare hF rfl he hsch,
    envs_frame hF he, heap_frame hF hR, by rw [objEntry_bare hF rfl hR]; exact hpend, ?_⟩
  have := frame_trans_bare hfr hF rfl rfl
  obtain ⟨b, p, j⟩ := fp
  simp only at hfj
  subst hfj
  simpa using this

