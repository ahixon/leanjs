        (bdV := bd2) (d := P_d) (bdM := P_bdM) (bdL := P_bdL) (bdW := P_bdW) (bdP := P_bdP) (fM := P_fM) (fL := P_fL) (fW := P_fW) (fP := P_fP) (dM := P_dM) (dL := P_dL) (dW := P_dW) (dP := P_dP) (hf := by omega) (hlt := lt_heap_of_frame hw hPEo)
