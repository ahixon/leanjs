import JSProofs.FactsComposeFlushMutation
import JSProofs.FactsComposeFlushLayout
import JSProofs.FactsComposeSpawned
import JSProofs.FactsComposeExample
import JSProofs.ReactCommitRootFn
import JSProofs.ReactMarkFinished

/-! commitRootImpl with the click's passes, composed in Lean (`ReactCommitRootFnFull.cmr_full`, generated by
`gen_cmr_full.py`): markRootFinished by `mrf_spec`, the before-mutation pass by `cbm_comp`, the mutation pass by
`fme_comp`, the layout pass by `fle_comp`, the spawned work by `fsp_comp`. -/

facts_form ReactCommitRootFn.cmr_spec
facts_form ReactMarkFinished.mrf_spec

namespace ReactCommitRootFn
open ES Logic ReactFacts

facts_compose cmr_comp {EA XA dom : ObjId} {kP : JSStr} {R1 R2 : State → σ → Prop} {gP : EnvId}
    {bFSR bEn : Binding} {fEn : ObjId} := cmr_spec
    (n := n + 9) (K := 5800)
    (sl := .num (F64.fin false 0 (-1074))) (ul := .num (F64.fin false 0 (-1074))) (srl := .num (F64.fin false 0 (-1074)))
    (fpM := ReactMarkFinished.FPM FR EA XA)
    (fpB := ReactBeforeMutation.FB d.env)
    (fpME := ((ReactFlushMutation.FPRE d.env RSI RDSI).union ((ReactCommitRoot.F0 d.env).union
      (Footprint.union ⟨[(d.env, JSStr.ofString "offscreenDirectParentIsHidden")], [], false⟩
        ⟨[(d.env, JSStr.ofString "viewTransitionMutationContext")], [(dom, .str kP)], false⟩))).union
      ⟨[(d.env, JSStr.ofString "selectionInformation"), (d.env, JSStr.ofString "eventsEnabled"),
        (d.env, JSStr.ofString "_enabled")], [(FR, .str (JSStr.ofString "current"))], false⟩)
    (Q1 := fun w h => (∃ w0 : State, (∃ w0 h0, R1 w0 h0) ∧ (∃ w0, R2 w0 h) ∧ HI h) ∧
      BindIs w d.env (JSStr.ofString "pendingEffectsStatus") (.num (F64.fin false 4503599627370496 (-51))) ∧
      BindIs w d.env (JSStr.ofString "executionContext") (.num ec) ∧ PropIs w RSI (JSStr.ofString "T") tv ∧
      PropIs w RDSI (JSStr.ofString "p") pv)
    (fpLE := ReactFlushLayout.FPL d.env RSI RDSI)
    (Q2 := fun w h => (∃ w0 : State, (∃ w0 h0, R1 w0 h0) ∧ (∃ w0, R2 w0 h) ∧ HI h) ∧
      BindIs w d.env (JSStr.ofString "pendingEffectsStatus") (.num (F64.fin false 6755399441055744 (-51))))
    (fpSP := (ReactSpawned.FPA d.env gP FR).union (ReactEnsureCall.fpEn d.env))
    (Q3 := fun w h => (∃ w0 : State, (∃ w0 h0, R1 w0 h0) ∧ (∃ w0, R2 w0 h) ∧ HI h) ∧
      ReactSpawned.Done w d.env oG FR bFSR bEn fEn)
  | hMf => ReactMarkFinished.mrf_spec (EA := EA) (XA := XA) by
      rintro v w' h' ⟨-, hpl, hF, hfu, rfl⟩
      exact ⟨hF, frame_trans ‹Frame _ s _› hF, by omega, rfl, ⟨_, _, _, hpl⟩⟩
  | hBf => ReactBeforeMutation.cbm_comp (E := E) (ev0 := ev0) with u_d.env = d.env by
      have he := hob.get.2
      rintro v w' h' ⟨-, rfl, hF, hfu, ⟨SI, hSI1, hSI2, hSI3, hSI4, hSI5, hSI6⟩, hev, hen⟩
      rw [he] at hF hSI6 hev hen
      have hw := ‹Frame _ s _›
      exact ⟨hF, frame_trans hw hF, by omega, rfl, ⟨SI, Nat.le_trans hw.heap_le hSI1, hSI2, hSI3, hSI4, hSI5, hSI6⟩,
        hev, hen⟩
  | hMEf => ReactFlushMutation.fme_comp (dom := dom) (kP := kP) (R1 := R1) (R2 := R2) (FR := FR) (RSI := RSI)
      (RDSI := RDSI) (ec := ec) (tv := tv) (pv := pv) with u_d.env = d.env by
      have he := hob.get.2
      rintro v w' h' ⟨-, hfu, hPC, -, hF, hst2, hec2, hT2, hp2⟩
      rw [he] at hF hst2 hec2
      exact ⟨hF, frame_trans ‹Frame _ s _› hF, by omega, hPC, hst2, hec2, hT2, hp2⟩
  | hLEf => ReactFlushLayout.fle_comp (RSI := RSI) (RDSI := RDSI) with u_d.env = d.env by
      have he := hob.get.2
      rintro v w' h' ⟨-, hfu, hF, rfl, hst3⟩
      rw [he] at hF hst3
      exact ⟨hF, frame_trans ‹Frame _ s _› hF, by omega, (‹(∃ w0 : State, _) ∧ _›).1, hst3⟩
  | hSPf => ReactSpawned.fsp_comp (FR := FR) (oG := oG) (gP := gP) (bFSR := bFSR) (bEn := bEn) (fEn := fEn)
      with u_d.env = d.env by
      have he := hob.get.2
      rintro v w' h' ⟨-, hfu, rfl, hF, hD⟩
      rw [he] at hF hD
      exact ⟨frame_trans ‹Frame _ s _› hF, by omega, (‹(∃ w0 : State, _) ∧ _›).1, hD⟩

end ReactCommitRootFn
