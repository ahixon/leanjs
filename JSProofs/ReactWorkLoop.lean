import JSProofs.ReactUnitRoot
import JSProofs.ReactUnitCounter
import JSProofs.ReactUnitButton
import JSProofs.WLSGen

/-!
# workLoopSync in the click's render (zippy docs/react-proofs.md)

`workLoopSync()`: `for (; null !== workInProgress; ) performUnitOfWork(workInProgress)` over the root fiber
(`ReactUnitRoot`: its bailout clones the counter fiber), the counter fiber (`ReactUnitCounter`: the component
re-rendered, the button fiber reused with the new props), and the button fiber (`ReactUnitButton`: its text child set
as text content, then completed with the counter and the root); `workInProgress` is then `null`. Generated by
`tools/gen_react_wls.py`.
-/

open ES ES.M HostRuns Logic ReactReducer ReactUpdateReducer ReactUseState ReactCounter ReactRenderHooks ReactBeginCounter
open Std (HashMap)

namespace ReactWorkLoop

section
variable {eng : Engine} {σ : Type} {answer : HostAnswer σ}

theorem simpleW (d : FuncData) (hc : d.code = WLSGen.workLoopSync_func) : FDI.Simple d := by
  constructor <;> rw [hc] <;> try rfl
  simp [WLSGen.workLoopSync_func, Func.params, Func.info]

