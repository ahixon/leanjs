[unverified] outside the verified core (unsupported for Lean: only non-recursive one-parameter functions); using the legacy translator
let add := fun a b => a + b
let square := fun x => x * x
let sumOfSquares := fun a b => let s := add (square a) (square b)
return s
let result := #[sumOfSquares 3 4, add "a" "b", typeof add, !true, 7 % 3]
result
[exit 0]
