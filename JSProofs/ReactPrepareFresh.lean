import JSProofs.ReactCreateWIP
import JSProofs.ReactPrepCallees
import JSProofs.ReactFinishQueueing
import JSProofs.ReactPrerender
import JSProofs.PFSGen

/-!
# React's `prepareFreshStack` for a click's render in the steady state (zippy docs/react-proofs.md)

`prepareFreshStack(root, 2)`: no timeout or pending commit to cancel, nothing in progress to reset, the host root's
alternate `X` reused as the work in progress (`createWorkInProgress`), the render's state reset, not prerendering, no
entangled lanes, and the click's queued update moved onto the hook queue with its lane marked up to the root
(`finishQueueingConcurrentUpdates`). Each callee by its theorem. Case: the counter fiber
`setN` holds is the current one (its `return` is the current host root `H`). The statement was generated; the proof
applies each callee's spec at its call (`js_norm [CallableC, …]`, `refine wp_mono (spec …)`), with explicit facts about
each callee's final state (records, objects) for the reads after it.
-/

open ES ES.M HostRuns Logic
open Std (HashMap)

namespace ReactPrepareFresh

/-- Writing a record its own current value changes nothing. -/
theorem setEnv_eq_self_of {u : State} {e : EnvId} {v : Env} (h : u.envEntry e = v) (he : e < u.envs.size) :
    u.setEnv e v = u := by
  subst h
  cases u
  simp only [State.setEnv, State.envEntry, State.mk.injEq, and_true, true_and]
  apply Array.ext
  · simp
  · intro i h1 h2
    simp only [Array.getElem_modify]
    split
    · next hi => subst hi; simp [Array.getElem?_eq_getElem he]
    · rfl

open Lean Elab Tactic in
/-- One step of `frame_go'` (debugging). -/
elab "frame_step'" "[" facts:Lean.Parser.Tactic.simpArg,* "]" : tactic => do
  withMainContext do
    let some tac ← Logic.frameRuleFor (← getMainTarget) ⟨facts.elemsAndSeps⟩ | throwError "frame_step': none"
    evalTactic tac

section
variable {eng : Engine} {σ : Type} {answer : HostAnswer σ}

theorem simple (d : FuncData) (hc : d.code = PFSGen.prepareFreshStack_func) : FDI.Simple d := by
  constructor <;> rw [hc] <;> try rfl
  simp [PFSGen.prepareFreshStack_func, Func.params, Func.info]

/-- What it writes: the module's render state, the alternate root's fields, the queue, the lanes. -/
def fp (g : EnvId) (X A Qo U F Fa H : ObjId) : Footprint :=
  ⟨[(g, "pendingEffectsLanes"), (g, "workInProgressRoot"), (g, "workInProgress"), (g, "workInProgressRootRenderLanes"), (g, "workInProgressSuspendedReason"), (g, "workInProgressThrownValue"), (g, "workInProgressRootDidSkipSuspendedSiblings"), (g, "workInProgressRootIsPrerendering"), (g, "workInProgressRootDidAttachPingListener"), (g, "workInProgressSuspendedRetryLanes"), (g, "workInProgressDeferredLane"), (g, "workInProgressRootPingedLanes"), (g, "workInProgressRootInterleavedUpdatedLanes"), (g, "workInProgressRootSkippedLanes"), (g, "workInProgressRootExitStatus"), (g, "workInProgressRootRecoverableErrors"), (g, "workInProgressRootConcurrentErrors"), (g, "workInProgressRootDidIncludeRecursiveRenderUpdate"), (g, "entangledRenderLanes"), (g, "concurrentlyUpdatedLanes"), (g, "concurrentQueuesIndex")],
    (ReactCreateWIP.fp X).props ++ [(A, .str "0"), (A, .str "1"), (A, .str "2"), (A, .str "3"), (Qo, .str "pending"),
      (U, .str "next"), (F, .str "lanes"), (Fa, .str "lanes"), (H, .str "childLanes")], false⟩

/-- What `prepareFreshStack` leaves on the fibers and queues the work loop reads: the current root's alternate `X`
reset from it (`createWorkInProgress`), the update's lane on the fibers from the updated one to the root, the hook
queue's pending ring (`finishQueueingConcurrentUpdates`). -/
def PrepFields (w : State) (X H F Fa Qo U : ObjId) (vT vL vC vMP vMS vUQ vS vI vR vRC : Value) (fl hc fl' al : F64)
    (x0e x0c x1e x1c x2e x2c x3e x3c x4e x4c x5e x5c x6e x6c x7e x7c x8e x8c x9e x9c x10e x10c x11e x11c x12e x12c x13e x13c x14e x14c x15e x15c hcle hclc fle flc fale falc qpe qpc une unc : Bool) : Prop :=
  ((w.objEntry X).props.get? (.str "pendingProps") = some (.data .null true x0e x0c)) ∧
  ((w.objEntry X).props.get? (.str "type") = some (.data vT true x1e x1c)) ∧
  ((w.objEntry X).props.get? (.str "flags") = some (.data (.num (numberBinOp .bitAnd fl (F64.fin false 5062151534280704 (-22)))) true x2e x2c)) ∧
  ((w.objEntry X).props.get? (.str "subtreeFlags") = some (.data (.num (F64.fin false 0 (-1074))) true x3e x3c)) ∧
  ((w.objEntry X).props.get? (.str "deletions") = some (.data .null true x4e x4c)) ∧
  ((w.objEntry X).props.get? (.str "lanes") = some (.data vL true x6e x6c)) ∧
  ((w.objEntry X).props.get? (.str "child") = some (.data vC true x7e x7c)) ∧
  ((w.objEntry X).props.get? (.str "memoizedProps") = some (.data vMP true x8e x8c)) ∧
  ((w.objEntry X).props.get? (.str "memoizedState") = some (.data vMS true x9e x9c)) ∧
  ((w.objEntry X).props.get? (.str "updateQueue") = some (.data vUQ true x10e x10c)) ∧
  ((w.objEntry X).props.get? (.str "dependencies") = some (.data .null true x11e x11c)) ∧
  ((w.objEntry X).props.get? (.str "sibling") = some (.data vS true x12e x12c)) ∧
  ((w.objEntry X).props.get? (.str "index") = some (.data vI true x13e x13c)) ∧
  ((w.objEntry X).props.get? (.str "ref") = some (.data vR true x14e x14c)) ∧
  ((w.objEntry X).props.get? (.str "refCleanup") = some (.data vRC true x15e x15c)) ∧
  ((w.objEntry X).props.get? (.str "childLanes") = some (.data (.num (numberBinOp .bitOr hc (F64.fin false 4503599627370496 (-51)))) true x5e x5c)) ∧
  ((w.objEntry H).props.get? (.str "childLanes") = some (.data (.num (numberBinOp .bitOr hc (F64.fin false 4503599627370496 (-51)))) true hcle hclc)) ∧
  ((w.objEntry F).props.get? (.str "lanes") = some (.data (.num (numberBinOp .bitOr fl' (F64.fin false 4503599627370496 (-51)))) true fle flc)) ∧
  ((w.objEntry Fa).props.get? (.str "lanes") = some (.data (.num (numberBinOp .bitOr al (F64.fin false 4503599627370496 (-51)))) true fale falc)) ∧
  ((w.objEntry Qo).props.get? (.str "pending") = some (.data (.obj U) true qpe qpc)) ∧
  ((w.objEntry U).props.get? (.str "next") = some (.data (.obj U) true une unc))

/-- The module's variables `prepareFreshStack` sets that the work loop reads. -/
def PrepBinds (w : State) (g : EnvId) (oG : Option EnvId) (R X : ObjId) : Prop :=
  ∃ bm, Scope.declLike? (w.envEntry g) = some (bm, oG) ∧
    (∃ bd, bm[JSStr.ofString "workInProgress"]? = some bd ∧ bd.value = some (.obj X) ∧ bd.mutable = true) ∧
    (∃ bd, bm[JSStr.ofString "entangledRenderLanes"]? = some bd ∧ bd.value = some (.num (F64.fin false 4503599627370496 (-51)))) ∧
    (∃ bd, bm[JSStr.ofString "workInProgressRootSkippedLanes"]? = some bd ∧ bd.value = some (.num (F64.fin false 0 (-1074))) ∧ bd.mutable = true) ∧
    (∃ bd, bm[JSStr.ofString "workInProgressRootExitStatus"]? = some bd ∧ bd.value = some (.num (F64.fin false 0 (-1074))) ∧ bd.mutable = true)
    ∧ (∃ bd, bm[JSStr.ofString "workInProgressRoot"]? = some bd ∧ bd.value = some (.obj R) ∧ bd.mutable = true)
    ∧ (∃ bd, bm[JSStr.ofString "workInProgressRootRenderLanes"]? = some bd ∧ bd.value = some (.num (F64.fin false 4503599627370496 (-51))) ∧ bd.mutable = true)
    ∧ (∃ bd, bm[JSStr.ofString "workInProgressRootRecoverableErrors"]? = some bd ∧ bd.value = some .null)
    ∧ (∃ bd, bm[JSStr.ofString "workInProgressRootDidIncludeRecursiveRenderUpdate"]? = some bd ∧ bd.value = some (.bool false))
    ∧ (∃ bd, bm[JSStr.ofString "workInProgressDeferredLane"]? = some bd ∧ bd.value = some (.num (F64.fin false 0 (-1074))))
    ∧ (∃ bd, bm[JSStr.ofString "workInProgressRootInterleavedUpdatedLanes"]? = some bd ∧ bd.value = some (.num (F64.fin false 0 (-1074))))
    ∧ (∃ bd, bm[JSStr.ofString "workInProgressSuspendedRetryLanes"]? = some bd ∧ bd.value = some (.num (F64.fin false 0 (-1074))))
    ∧ (∃ bd, bm[JSStr.ofString "workInProgressRootDidSkipSuspendedSiblings"]? = some bd ∧ bd.value = some (.bool false))
    ∧ (∃ bd, bm[JSStr.ofString "concurrentQueuesIndex"]? = some bd ∧ bd.mutable = true ∧ bd.value = some (.num (F64.fin false 0 (-1074))))
    ∧ (∃ bd, bm[JSStr.ofString "concurrentlyUpdatedLanes"]? = some bd ∧ bd.mutable = true ∧ bd.value.isSome = true)
    ∧ (∃ bd, bm[JSStr.ofString "pendingEffectsLanes"]? = some bd ∧ bd.mutable = true ∧ bd.value.isSome = true)

