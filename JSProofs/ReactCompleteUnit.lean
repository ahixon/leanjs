import JSProofs.ReactCompleteRoot
import JSProofs.Loops3
import JSProofs.CUWGen

/-!
# completeUnitOfWork from the counter's button (zippy docs/react-proofs.md)

`completeUnitOfWork(button)` in the click's render: the button's `beginWork` returned `null`, so the work loop
completes it and climbs: `completeWork` for the button (`ReactCompleteButton.button_spec`), the counter
(`counter_spec`, which merges the button's new flags) and the root (`ReactCompleteRoot.root_spec`, which merges the
counter's); none has a sibling; the root has no return, so `workInProgress` ends `null` and the exit status becomes
5 (completed).
-/

open ES ES.M HostRuns Logic
open Std (HashMap)

namespace ReactCompleteUnit

section
variable {eng : Engine} {σ : Type} {answer : HostAnswer σ}

theorem simpleU (d : FuncData) (hc : d.code = CUWGen.completeUnitOfWork_func) : FDI.Simple d := by
  constructor <;> rw [hc] <;> try rfl
  simp [CUWGen.completeUnitOfWork_func, Func.params, Func.info]

/-- What it writes: `workInProgress`, the exit status, and the three `completeWork`s' writes. -/
def fpU (g : EnvId) (VS Cu Cx CS CF RI R C X : ObjId) : Footprint :=
  ⟨[(g, "workInProgress"), (g, "workInProgressRootExitStatus"), (g, "index")],
    (ReactCompleteButton.fpCW X).props ++ (ReactCompleteButton.fpCC C X).props ++
      (ReactCompleteRoot.fpRC g VS Cu Cx CS CF RI R C).props, false⟩

set_option linter.unusedSimpArgs false in
set_option linter.unusedVariables false in
set_option maxHeartbeats 16000000 in
set_option maxRecDepth 100000 in
/-- **`completeUnitOfWork(button)`**: the button, the counter and the root completed. -/
