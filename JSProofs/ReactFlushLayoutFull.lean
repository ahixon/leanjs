    (L_hRc : (s.objEntry R).props.get? (.str (JSStr.ofString "child")) = some (.data (.obj L_K) L_rcw L_rce L_rcc))
    (L_hKa' : (s.objEntry L_K).props.get? (.str (JSStr.ofString "alternate")) = some (.data (.obj L_Kc) L_raw L_rae L_rac))
    (L_hKsib : (s.objEntry L_K).props.get? (.str (JSStr.ofString "sibling")) = some (.data .null L_rbw L_rbe L_rbc))
    (hf : 2200 ≤ s.fuel)
    (L_hdenv : L_d.env = d.env)
    {L_bdRT L_bdC : Binding}
    (L_hGRT : bG[JSStr.ofString "recursivelyTraverseLayoutEffects"]? = some L_bdRT) (L_hGRTv : L_bdRT.value = some (.obj L_fRT))
    (L_hGC : bG[JSStr.ofString "commitLayoutEffectOnFiber"]? = some L_bdC) (L_hGCv : L_bdC.value = some (.obj fC))
    (d_RT : R ≠ RSI) (d_RD : R ≠ RDSI)
    (d_L_KT : L_K ≠ RSI) (d_L_KD : L_K ≠ RDSI)
    (d_L_BT : L_B ≠ RSI) (d_L_BD : L_B ≠ RDSI)
    (d_fCT : fC ≠ RSI) (d_fCD : fC ≠ RDSI)
    (d_L_fRTT : L_fRT ≠ RSI) (d_L_fRTD : L_fRT ≠ RDSI) :
    WP eng answer (n + 10) h (callImpl eng (.obj fo) t #[]) s fun v w h' =>
      v = .undefined ∧ s.fuel ≤ w.fuel + 2140 ∧ Frame (FPL d.env RSI RDSI) s w ∧ h' = h ∧
      BindIs w d.env (JSStr.ofString "pendingEffectsStatus") (.num (F64.fin false 6755399441055744 (-51))) := by
  refine fle_spec (n := n + 8) (KC := 1840) (hlt := hlt) (hk := hk) (hcode := hcode) (hcls := hcls) (hmode := hmode) (hG := hG) (hGe := hGe) (hGS := hGS) (hGSv := hGSv) (hGSm := hGSm) (hGR := hGR) (hGRv := hGRv) (hGF := hGF) (hGFv := hGFv) (hGT := hGT) (hGTv := hGTv) (hGD := hGD) (hGDv := hGDv) (hGE := hGE) (hGEv := hGEv) (hGEm := hGEm) (hGC := hGC) (hGCv := hGCv) (hR := hR) (hRk := hRk) (hRf := hRf) (hRs := hRs) (hRa := hRa) (hsf := hsf) (hRSI := hRSI) (hRSIk := hRSIk) (hRSIt := hRSIt) (hRDSI := hRDSI) (hRDSIk := hRDSIk) (hRDSIp := hRDSIp) (hCo := hCo) (dTD := dTD) (dTR := dTR) (dDR := dDR) (dTC := dTC) (dDC := dDC) (hf := by omega) (hCc := ⟨_, L_hk⟩) (hC := ?hC)
  case hC =>
    intro w h1 hw hfw
    obtain ⟨bw, hdw, hbw⟩ := declLike_frame hw hG hGe
    have hRT' : bw[JSStr.ofString "recursivelyTraverseLayoutEffects"]? = some L_bdRT := by
      rw [hbw _ (by simp [FPL])]; exact L_hGRT
    have hC' : bw[JSStr.ofString "commitLayoutEffectOnFiber"]? = some L_bdC := by
      rw [hbw _ (by simp [FPL])]; exact L_hGC
    refine wp_mono (Q := fun v w' h' => v = .undefined ∧ w.fuel ≤ w'.fuel + 1740 ∧ Frame {} w w' ∧ h' = h1) ?_ ?_
    · apply ReactLayoutFull.lay_root (s := w) (n := n + 1) (fo := fC) (t := .undefined) (rv := .obj FR) (rcv := av)
        (R := R) (bG := bw) (oG := oG) (bdRT := L_bdRT) (bdC := L_bdC) (Kc := L_Kc) (rf := L_rf) (rs := L_rs) (rfw := L_rfw) (rfe := L_rfe) (rfc := L_rfc) (rtw := L_rtw) (rte := L_rte) (rtc := L_rtc) (rsw := L_rsw) (rse := L_rse) (rsc := L_rsc) (rcw := L_rcw) (rce := L_rce) (rcc := L_rcc) (raw := L_raw) (rae := L_rae) (rac := L_rac) (rbw := L_rbw) (rbe := L_rbe) (rbc := L_rbc) (K := L_K) (kf := L_kf) (ks := L_ks) (kfw := L_kfw) (kfe := L_kfe) (kfc := L_kfc) (ktw := L_ktw) (kte := L_kte) (ktc := L_ktc) (ksw := L_ksw) (kse := L_kse) (ksc := L_ksc) (kcw := L_kcw) (kce := L_kce) (kcc := L_kcc) (kaw := L_kaw) (kae := L_kae) (kac := L_kac) (kbw := L_kbw) (kbe := L_kbe) (kbc := L_kbc) (d := L_d) (B := L_B) (Bc := L_Bc) (bf := L_bf) (bs := L_bs) (bfw := L_bfw) (bfe := L_bfe) (bfc := L_bfc) (btw := L_btw) (bte := L_bte) (btc := L_btc) (bsw := L_bsw) (bse := L_bse) (bsc := L_bsc) (fRT := L_fRT) (dRT := L_dRT)
        (hf := hfw) (hG := by rw [L_hdenv]; exact lt_envs_of_frame hw hG)
        (hGe := by rw [L_hdenv]; exact hdw) (hGRT := hRT') (hGRTv := L_hGRTv) (hGC := hC') (hGCv := L_hGCv)
        (hlt := lt_heap_of_frame hw hCo)
      all_goals rebase_fpl hw
    · rintro v w' h' ⟨-, hfu, hF, rfl⟩
      exact ⟨hF, by omega, rfl⟩

end

