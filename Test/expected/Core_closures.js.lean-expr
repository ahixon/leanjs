[unverified] outside the verified core (unsupported for Lean: named function (`function` declaration or expression; use an arrow function)); using the legacy translator
let makeAdder := fun n => fun x => x + n
let add5 := makeAdder 5
let apply := fun f x => return f x
let twice := fun f => fun x => f (f x)
let result := { a := apply add5 10, b := makeAdder "x" "y", c := twice add5 0 }
result
[exit 0]
