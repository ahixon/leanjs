import JSProofs.ReactFlushLayout
import JSProofs.ReactLayoutFull

/-!
# flushLayoutEffects with the click's layout pass (zippy docs/react-proofs.md)

`fle_full`: `fle_spec` with its contract for `commitLayoutEffectOnFiber(root, finishedWork.alternate, finishedWork)`
discharged by `ReactLayoutFull.lay_root` at the call state (generated by `tools/react_commit/gen_fle_full.py`;
`lay_root`'s premises prefixed `L_`, its module record the call state's, its two function bindings through the frame).
-/

open ES ES.M HostRuns Logic
open Std (HashMap)
open ReactFacts (BindIs)

namespace ReactFlushLayout

/-- `rebase_tac` for `FPL`'s frame: an object other than `RSI` and `RDSI` is as it was. -/
macro "rebase_fpl" hw:term : tactic => `(tactic| first
  | rebase_quick $hw
  | (rw [($hw).obj_eq _ (by with_reducible assumption) (fun _ hh => by
      simp [FPL] at hh
      rcases hh with ⟨hh, -⟩ | ⟨hh, -⟩ <;> first | exact absurd hh (by assumption) | exact absurd hh.symm (by assumption))]
      <;> with_reducible assumption))

section
variable {eng : Engine} {σ : Type} {answer : HostAnswer σ}

set_option maxRecDepth 40000 in
set_option maxHeartbeats 8000000 in
theorem fle_full {n : Nat}
    {h : σ}
    {fo : ObjId}
    {d : FuncData}
    {t : Value}
    {s : State}
    {bG : HashMap JSStr Binding}
    {oG : Option EnvId}
    {bdS : Binding}
    {bdR : Binding}
    {bdF : Binding}
    {bdT : Binding}
    {bdD : Binding}
    {bdE : Binding}
    {bdC : Binding}
    {FR : ObjId}
    {R : ObjId}
    {RSI : ObjId}
    {RDSI : ObjId}
    {fC : ObjId}
    {av : Value}
    {tv : Value}
    {pv : Value}
    {rf : F64}
    {sf : F64}
    {ec : F64}
    {rfw : Bool}
    {rfe : Bool}
    {rfc : Bool}
    {sfw : Bool}
    {sfe : Bool}
    {sfc : Bool}
    {aw : Bool}
    {ae : Bool}
    {ac : Bool}
    {te : Bool}
    {tc : Bool}
    {pe : Bool}
    {pc : Bool}
    (hlt : fo < s.heap.size)
    (hk : (s.objEntry fo).kind = .func d)
    (hcode : d.code = FLEGen.flushLayoutEffects_func)
    (hcls : d.isClassCtor = false)
    (hmode : d.thisMode = .strict)
    (hG : d.env < s.envs.size)
    (hGe : Scope.declLike? (s.envEntry d.env) = some (bG, oG))
    (hGS : bG[JSStr.ofString "pendingEffectsStatus"]? = some bdS)
    (hGSv : bdS.value = some (.num (F64.fin false 4503599627370496 (-51))))
    (hGSm : bdS.mutable = true)
    (hGR : bG[JSStr.ofString "pendingEffectsRoot"]? = some bdR)
    (hGRv : bdR.value = some (.obj FR))
    (hGF : bG[JSStr.ofString "pendingFinishedWork"]? = some bdF)
    (hGFv : bdF.value = some (.obj R))
    (hGT : bG[JSStr.ofString "ReactSharedInternals"]? = some bdT)
    (hGTv : bdT.value = some (.obj RSI))
    (hGD : bG[JSStr.ofString "ReactDOMSharedInternals"]? = some bdD)
    (hGDv : bdD.value = some (.obj RDSI))
    (hGE : bG[JSStr.ofString "executionContext"]? = some bdE)
    (hGEv : bdE.value = some (.num ec))
    (hGEm : bdE.mutable = true)
    (hGC : bG[JSStr.ofString "commitLayoutEffectOnFiber"]? = some bdC)
    (hGCv : bdC.value = some (.obj fC))
    (hR : R < s.heap.size)
    (hRk : (s.objEntry R).kind.isPlain = true)
    (hRf : (s.objEntry R).props.get? (.str (JSStr.ofString "flags")) = some (.data (.num rf) rfw rfe rfc))
    (hRs : (s.objEntry R).props.get? (.str (JSStr.ofString "subtreeFlags")) = some (.data (.num sf) sfw sfe sfc))
    (hRa : (s.objEntry R).props.get? (.str (JSStr.ofString "alternate")) = some (.data av aw ae ac))
    (hsf : isStrictlyEqual (.num (F64.fin false 0 (-1074)))
      (.num (numberBinOp .bitAnd sf (F64.fin false 4822457999425536 (-39)))) = false)
    (hRSI : RSI < s.heap.size)
    (hRSIk : (s.objEntry RSI).kind.isPlain = true)
    (hRSIt : (s.objEntry RSI).props.get? (.str (JSStr.ofString "T")) = some (.data tv true te tc))
    (hRDSI : RDSI < s.heap.size)
    (hRDSIk : (s.objEntry RDSI).kind.isPlain = true)
    (hRDSIp : (s.objEntry RDSI).props.get? (.str (JSStr.ofString "p")) = some (.data pv true pe pc))
    (hCo : fC < s.heap.size)
    (dTD : RSI ≠ RDSI)
    (dTR : RSI ≠ R)
    (dDR : RDSI ≠ R)
    (dTC : RSI ≠ fC)
    (dDC : RDSI ≠ fC)
    {L_Kc : ObjId}
    {L_rf : F64}
    {L_rs : F64}
    {L_rfw : Bool}
    {L_rfe : Bool}
    {L_rfc : Bool}
    {L_rtw : Bool}
    {L_rte : Bool}
    {L_rtc : Bool}
    {L_rsw : Bool}
    {L_rse : Bool}
    {L_rsc : Bool}
    {L_rcw : Bool}
    {L_rce : Bool}
    {L_rcc : Bool}
    {L_raw : Bool}
    {L_rae : Bool}
    {L_rac : Bool}
    {L_rbw : Bool}
    {L_rbe : Bool}
    {L_rbc : Bool}
    {L_K : ObjId}
    {L_kf : F64}
    {L_ks : F64}
    {L_kfw : Bool}
    {L_kfe : Bool}
    {L_kfc : Bool}
    {L_ktw : Bool}
    {L_kte : Bool}
    {L_ktc : Bool}
    {L_ksw : Bool}
    {L_kse : Bool}
    {L_ksc : Bool}
    {L_kcw : Bool}
    {L_kce : Bool}
    {L_kcc : Bool}
    {L_kaw : Bool}
    {L_kae : Bool}
    {L_kac : Bool}
    {L_kbw : Bool}
    {L_kbe : Bool}
    {L_kbc : Bool}
    {L_d : FuncData}
    {L_B : ObjId}
    {L_Bc : ObjId}
    {L_bf : F64}
    {L_bs : F64}
    {L_bfw : Bool}
    {L_bfe : Bool}
    {L_bfc : Bool}
    {L_btw : Bool}
    {L_bte : Bool}
    {L_btc : Bool}
    {L_bsw : Bool}
    {L_bse : Bool}
    {L_bsc : Bool}
    {L_fRT : ObjId}
    {L_dRT : FuncData}
    (L_hk : (s.objEntry fC).kind = .func L_d)
    (L_hcode : L_d.code = CLEGen.commitLayoutEffectOnFiber_func)
    (L_hcls : L_d.isClassCtor = false)
    (L_hmode : L_d.thisMode = .strict)
    (L_hRTo : L_fRT < s.heap.size)
    (L_hRTk : (s.objEntry L_fRT).kind = .func L_dRT)
    (L_hRTcode : L_dRT.code = RTLGen.recursivelyTraverseLayoutEffects_func)
    (L_hRTcls : L_dRT.isClassCtor = false)
    (L_hRTmode : L_dRT.thisMode = .strict)
    (L_hRTenv : L_dRT.env = L_d.env)
    (L_hB : L_B < s.heap.size)
    (L_hBk : (s.objEntry L_B).kind.isPlain = true)
    (L_hBf : (s.objEntry L_B).props.get? (.str (JSStr.ofString "flags")) = some (.data (.num L_bf) L_bfw L_bfe L_bfc))
    (L_hBt : (s.objEntry L_B).props.get? (.str (JSStr.ofString "tag")) =
      some (.data (.num (F64.fin false 5629499534213120 (-50))) L_btw L_bte L_btc))
    (L_h512 : numberBinOp .bitAnd L_bf (F64.fin false 4503599627370496 (-43)) = F64.fin false 0 (-1074))
    (L_hBs : (s.objEntry L_B).props.get? (.str (JSStr.ofString "subtreeFlags")) = some (.data (.num L_bs) L_bsw L_bse L_bsc))
    (L_hbs : numberBinOp .bitAnd L_bs (F64.fin false 4822457999425536 (-39)) = F64.fin false 0 (-1074))
    (L_hK : L_K < s.heap.size)
    (L_hKk : (s.objEntry L_K).kind.isPlain = true)
    (L_hKf : (s.objEntry L_K).props.get? (.str (JSStr.ofString "flags")) = some (.data (.num L_kf) L_kfw L_kfe L_kfc))
    (L_hKt : (s.objEntry L_K).props.get? (.str (JSStr.ofString "tag")) =
      some (.data (.num (F64.fin false 0 (-1074))) L_ktw L_kte L_ktc))
    (L_h4 : numberBinOp .bitAnd L_kf (F64.fin false 4503599627370496 (-50)) = F64.fin false 0 (-1074))
    (L_hKs : (s.objEntry L_K).props.get? (.str (JSStr.ofString "subtreeFlags")) = some (.data (.num L_ks) L_ksw L_kse L_ksc))
    (L_hKsf : (!((numberBinOp .bitAnd L_ks (F64.fin false 4822457999425536 (-39))).isZero ||
      numberBinOp .bitAnd L_ks (F64.fin false 4822457999425536 (-39)) == F64.nan)) = true)
    (L_hKc : (s.objEntry L_K).props.get? (.str (JSStr.ofString "child")) = some (.data (.obj L_B) L_kcw L_kce L_kcc))
    (L_hBa' : (s.objEntry L_B).props.get? (.str (JSStr.ofString "alternate")) = some (.data (.obj L_Bc) L_kaw L_kae L_kac))
    (L_hBsib : (s.objEntry L_B).props.get? (.str (JSStr.ofString "sibling")) = some (.data .null L_kbw L_kbe L_kbc))
    (L_hR : R < s.heap.size)
    (L_hRk : (s.objEntry R).kind.isPlain = true)
    (L_hRf : (s.objEntry R).props.get? (.str (JSStr.ofString "flags")) = some (.data (.num L_rf) L_rfw L_rfe L_rfc))
    (L_hRt : (s.objEntry R).props.get? (.str (JSStr.ofString "tag")) =
      some (.data (.num (F64.fin false 6755399441055744 (-51))) L_rtw L_rte L_rtc))
    (L_h64 : numberBinOp .bitAnd L_rf (F64.fin false 4503599627370496 (-46)) = F64.fin false 0 (-1074))
    (L_hRs : (s.objEntry R).props.get? (.str (JSStr.ofString "subtreeFlags")) = some (.data (.num L_rs) L_rsw L_rse L_rsc))
    (L_hRsf : (!((numberBinOp .bitAnd L_rs (F64.fin false 4822457999425536 (-39))).isZero ||
