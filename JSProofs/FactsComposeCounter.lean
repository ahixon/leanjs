import JSProofs.FactsCompose
import JSProofs.ReactCommitCounter
import JSProofs.ReactCommitButtonFull
import JSProofs.ReactCommitTraverse
import JSProofs.ReactCommitRec

/-! The counter's commit, composed in Lean (`ReactCommitCounterFull.cme_counter_full`, generated by
`gen_counter_full.py`): the traversal of its one child, the button, by `rtm_one` with the button's commit
(`cme_button_full`), and its reconciliation by `cre_spec`. The button's DOM node `dom`, its props key `kP`, and the
predicates `R1`/`R2` its updates establish are the composites' own parameters. -/

facts_form ReactCommitCounter.cme_counter
facts_form ReactCommitTraverse.rtm_one
facts_form ReactCommitButton.cme_button_full
facts_form ReactCommitRec.cre_spec

namespace ReactCommitCounter
open ES Logic

-- The traversal of the counter's one child, the button.
facts_compose rtm_btn {dom : ObjId} {kP : JSStr} {R1 R2 : State → σ → Prop} := ReactCommitTraverse.rtm_one
    (n := n + 5) (KC := 3500)
    (fpC := Footprint.union ⟨[(d.env, JSStr.ofString "offscreenDirectParentIsHidden")], [], false⟩
      ⟨[(d.env, JSStr.ofString "viewTransitionMutationContext")], [(dom, .str kP)], false⟩)
    (PC := fun w h => (∃ w0 h0, R1 w0 h0) ∧ (∃ w0, R2 w0 h) ∧ HI h ∧ (∀ bm o, Scope.declLike? (w.envEntry d.env) =
      some (bm, o) → ∃ bd, bm[JSStr.ofString "viewTransitionMutationContext"]? = some bd ∧ bd.mutable = true ∧
        bd.value.isSome = true))
  | hfpC := by intro p hp; simp [Footprint.union] at hp; rcases hp with rfl | rfl <;> rfl
  | hC => ReactCommitButton.cme_button_full (dom := dom) (CH_kP := kP) (CH_U_R1 := R1) (CH_U_R2 := R2)
      with u_d.env = d.env ∧ u_CH_d.env = d.env ∧ C < w.heap.size ∧ (w.objEntry C).kind.isPlain = true ∧
        (∃ sw se sc, (w.objEntry C).props.get? (.str (JSStr.ofString "sibling")) = some (.data .null sw se sc)) ∧
        dom ≠ C by
      obtain ⟨hd1, hd2, hCl, hCk, hCs, hDC⟩ := hob.get.2
      rintro v w' h' ⟨-, hfu, hPC, hF⟩
      rw [hd1, hd2] at hF
      rw [hd1] at hPC
      have hCe : w'.objEntry C = w.objEntry C :=
        hF.obj_eq C hCl (fun k hk => by simp [Footprint.union] at hk; exact hDC hk.1.symm)
      exact ⟨hF, Nat.le_trans hfu (Nat.add_le_add_left (by decide) _), hPC, lt_heap_of_frame hF hCl, by rw [hCe]; exact hCk, by rw [hCe]; exact hCs⟩

-- The counter's commit: the traversal by `rtm_btn`, the reconciliation by `cre_spec`.
facts_compose cme_counter_comp {dom : ObjId} {kP : JSStr} {R1 R2 : State → σ → Prop} := cme_counter
    (n := n + 5) (KR := 3500)
    (fpC := Footprint.union ⟨[(d.env, JSStr.ofString "offscreenDirectParentIsHidden")], [], false⟩
      ⟨[(d.env, JSStr.ofString "viewTransitionMutationContext")], [(dom, .str kP)], false⟩)
    (PC := fun w h => (∃ w0 h0, R1 w0 h0) ∧ (∃ w0, R2 w0 h) ∧ HI h ∧ (∀ bm o, Scope.declLike? (w.envEntry d.env) =
      some (bm, o) → ∃ bd, bm[JSStr.ofString "viewTransitionMutationContext"]? = some bd ∧ bd.mutable = true ∧
        bd.value.isSome = true))
  | hRT => rtm_btn (dom := dom) (kP := kP) (R1 := R1) (R2 := R2) with u_d.env = d.env by
      have he := hob.get.2
      rintro v w' h' hq
      rw [he] at hq
      exact hq
  | hRE => ReactCommitRec.cre_spec by
      rintro v w' h' ⟨-, hF, hfu, hh, hH⟩
      exact ⟨hF, hfu, hh, hH⟩

end ReactCommitCounter
