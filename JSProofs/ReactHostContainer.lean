/-!
# React's `pushHostContainer` for the root's container (zippy docs/react-proofs.md)

`pushHostContainer(fiber, container)` at the start of a render (stack index -1): the container, the fiber and `null`
pushed on the three host cursors, then the container's namespace context: an element (`nodeType` 1) in the HTML
namespace whose tag is `DIV`, so 0; the context cursor's `null` replaced by it. The DOM reads (`nodeType`, `tagName`,
`namespaceURI`: accessors whose getters the host answers) are hypotheses about Zippy's bindings: from every state the
function's writes can reach, the read finds the getter, which returns the value and changes nothing.
-/

open ES ES.M HostRuns Logic
open Std (HashMap)

namespace ReactHostContainer

section
variable {eng : Engine} {σ : Type} {answer : HostAnswer σ} {HI : σ → Prop}

theorem simple (d : FuncData) (hc : d.code = PHCGen.pushHostContainer_func) : FDI.Simple d := by
  constructor <;> rw [hc] <;> try rfl
  simp [PHCGen.pushHostContainer_func, Func.params, Func.info]

/-- What it writes: the stack index, three stack slots, the three cursors. -/
def fp (g : EnvId) (VS RI CF CS : ObjId) : Footprint :=
  ⟨[(g, "index")], [(VS, .str "0"), (VS, .str "1"), (VS, .str "2"), (RI, .str "current"), (CF, .str "current"),
    (CS, .str "current")], false⟩

/-- A DOM read, from any host state the host invariant `HI` holds of and with fuel for a built-in's call (two steps:
the call's, and its host answer's loop): the getter found and returning `v`; nothing changed but the fuel, one step of
it spent (the getter is a built-in: its call takes a step). -/
def DomRead (eng : Engine) (answer : HostAnswer σ) (HI : σ → Prop) (n : Nat) (s : State) (fp : Footprint) (C : ObjId)
    (k : JSStr) (v : Value) : Prop :=
  ∀ w h1, Frame fp s w → HI h1 → 2 ≤ w.fuel → GetsAcc eng answer n h1 w (.obj C) k fun v' w' h' =>
    v' = v ∧ h' = h1 ∧ ∃ f, w' = w.withFuel f ∧ w.fuel ≤ f + 1

