import JSProofs.FactsComposeCounter
import JSProofs.ReactCommitRoot
import JSProofs.ReactHoistable

/-! The root's commit, composed in Lean (`ReactCommitRootFull.cme_root_full`, generated by `gen_root_full.py`):
getHoistableRoot by `ghr_spec`, the traversal of the root's one child, the counter, by `rtm_one` with the counter's
commit (`cme_counter_comp`), the reconciliation by `cre_spec`. -/

facts_form ReactCommitRoot.cme_root
facts_form ReactHoistable.ghr_spec

namespace ReactCommitRoot
open ES Logic

-- The traversal of the root's one child, the counter.
facts_compose rtm_cnt {dom : ObjId} {kP : JSStr} {R1 R2 : State → σ → Prop} := ReactCommitTraverse.rtm_one
    (n := n + 7) (KC := 4200)
    (fpC := Footprint.union ⟨[(d.env, JSStr.ofString "offscreenDirectParentIsHidden")], [], false⟩
      ⟨[(d.env, JSStr.ofString "viewTransitionMutationContext")], [(dom, .str kP)], false⟩)
    (PC := fun w h => (∃ w0 h0, R1 w0 h0) ∧ (∃ w0, R2 w0 h) ∧ HI h ∧ (∀ bm o, Scope.declLike? (w.envEntry d.env) =
      some (bm, o) → ∃ bd, bm[JSStr.ofString "viewTransitionMutationContext"]? = some bd ∧ bd.mutable = true ∧
        bd.value.isSome = true))
  | hfpC := by intro p hp; simp [Footprint.union] at hp; rcases hp with rfl | rfl <;> rfl
  | hC => ReactCommitCounter.cme_counter_comp (dom := dom) (kP := kP) (R1 := R1) (R2 := R2)
      with u_d.env = d.env ∧ C < w.heap.size ∧ (w.objEntry C).kind.isPlain = true ∧
        (∃ sw se sc, (w.objEntry C).props.get? (.str (JSStr.ofString "sibling")) = some (.data .null sw se sc)) ∧
        dom ≠ C by
      obtain ⟨hd1, hCl, hCk, hCs, hDC⟩ := hob.get.2
      rintro v w' h' ⟨-, hfu, hPC, hF⟩
      rw [hd1] at hF hPC
      have hCe : w'.objEntry C = w.objEntry C :=
        hF.obj_eq C hCl (fun k hk => by simp [Footprint.union] at hk; exact hDC hk.1.symm)
      exact ⟨hF, by omega, hPC, lt_heap_of_frame hF hCl, by rw [hCe]; exact hCk, by rw [hCe]; exact hCs⟩

-- The root's commit.
facts_compose cme_root_comp {dom : ObjId} {kP : JSStr} {R1 R2 : State → σ → Prop} := cme_root
    (n := n + 7) (KR := 4200)
    (fpC := Footprint.union ⟨[(d.env, JSStr.ofString "offscreenDirectParentIsHidden")], [], false⟩
      ⟨[(d.env, JSStr.ofString "viewTransitionMutationContext")], [(dom, .str kP)], false⟩)
    (PC := fun _ h => (∃ w0 h0, R1 w0 h0) ∧ (∃ w0, R2 w0 h) ∧ HI h)
  | hPCst := fun _ _ _ hp _ _ => hp
  | hGHC => ReactHoistable.ghr_spec by
      rintro v w' h' ⟨-, hF, hfu, hh⟩
      exact ⟨hF, by omega, hh⟩
  | hRT => rtm_cnt (dom := dom) (kP := kP) (R1 := R1) (R2 := R2) with u_d.env = d.env by
      have he := hob.get.2
      rintro v w' h' ⟨rfl, hfu, hPC, hF⟩
      rw [he] at hF hPC
      exact ⟨rfl, hfu, ⟨hPC.1, hPC.2.1, hPC.2.2.1⟩, hF, fun bm o hd' => hPC.2.2.2 bm o hd'⟩
  | hRE => ReactCommitRec.cre_spec by
      rintro v w' h' ⟨-, hF, hfu, hh, hH⟩
      exact ⟨hF, hfu, hh, hH⟩

end ReactCommitRoot
