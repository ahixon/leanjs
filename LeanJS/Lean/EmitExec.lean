/-
  Executable Lean output for the verified core.

  The verified IR → Lean translator produces untyped Lean expressions whose
  meaning is the model semantics `LeanJS.Semantics.LeanEval`. This emitter
  prints such an expression as well-typed Lean over the dynamic value type
  of `LeanJS.Runtime`, so that the result can be compiled and run.

  Every core expression `e` becomes a term of type `R = Except Sig Val`.
  Each clause follows the corresponding rule of `LeanEval` (left-to-right
  evaluation, a signal from a subterm is propagated). Like the plain Lean
  emitter, this is a trusted component; the test suite runs its output and
  compares it with Node.js.
-/
import LeanJS.Lean.AST
import LeanJS.Semantics.LeanEval

namespace LeanJS.Lean.EmitExec

open LeanJS.Semantics
open LeanJS.IR

abbrev Res := Except String String

/-- Identifiers are always written as `«x»`, so source names can never clash
    with Lean keywords or with the runtime. -/
def name (x : String) : Res :=
  if x.isEmpty || x.any (fun c => c == '«' || c == '»' || c == '\n') then
    throw s!"identifier {x.quote} cannot be written as a Lean name"
  else pure s!"«{x}»"

def floatLit (f : Float) : String :=
  if f == f.floor && f.abs < 9007199254740992.0 && !(f == 0 && 1 / f < 0) then
    let n := toString f.abs.toUInt64.toNat
    if f < 0 then s!"(-{n})" else n
  else
    s!"(Float.ofBits {f.toBits})"

def lit : LeanLit → String
  | .natVal n => s!"(Val.num {n})"
  | .float f => s!"(Val.num {floatLit f})"
  | .string s => s!"(Val.str {s.quote})"
  | .bool b => s!"(Val.bool {b})"

def binOpName : IRBinOp → String
  | .add => "add" | .sub => "sub" | .mul => "mul" | .div => "div" | .mod => "mod"
  | .exp => "exp" | .eq => "eq" | .neq => "neq" | .lt => "lt" | .lte => "lte"
  | .gt => "gt" | .gte => "gte" | .and => "and" | .or => "or"
  | .bitAnd => "bitAnd" | .bitOr => "bitOr" | .bitXor => "bitXor"
  | .shl => "shl" | .shr => "shr" | .ushr => "ushr" | .strConcat => "strConcat"

def unaryOpName : IRUnaryOp → String
  | .neg => "neg" | .not => "not" | .bitNot => "bitNot" | .typeof => "typeof"

/-- A single-line term of type `R`. `scope` holds the names bound at this
    point; a free variable is a runtime error, as in the model semantics,
    rather than a compile-time error. -/
partial def expr (scope : List String) : LeanExpr → Res
  | .ident x =>
    if x ∈ scope then return s!"(pure {← name x})"
    else return s!"(throw (Sig.error {s!"unbound variable: {x}".quote}))"
  | .lit l => return s!"(pure {lit l})"
  | .unit => return "(pure Val.unit)"
  | .paren e => expr scope e
  | .lam [] _ => throw "fun with no parameters"
  | .lam [p] b => return s!"(pure (Val.fn fun {← name p.name} => {← expr (p.name :: scope) b}))"
  | .lam (p :: ps) b =>
    return s!"(pure (Val.fn fun {← name p.name} => {← expr (p.name :: scope) (.lam ps b)}))"
  | .app f a => return s!"(do Val.call (← {← expr scope f}) (← {← expr scope a}))"
  | .«let» x _ v b => return s!"(do let {← name x} ← {← expr scope v}; {← expr (x :: scope) b})"
  | .«if» c t (some e) =>
    return s!"(do if Val.truthy (← {← expr scope c}) then {← expr scope t} else {← expr scope e})"
  | .binOp op l r =>
    match leanBinOpToIR op with
    | some .and => return s!"(do Val.and (← {← expr scope l}) fun _ => {← expr scope r})"
    | some .or => return s!"(do Val.or (← {← expr scope l}) fun _ => {← expr scope r})"
    | some irop =>
      return s!"(do Val.binop .{binOpName irop} (← {← expr scope l}) (← {← expr scope r}))"
    | none => throw s!"unsupported operator {op}"
  | .unaryOp op a =>
    match leanUnaryOpToIR op with
    | some irop => return s!"(do Val.unop .{unaryOpName irop} (← {← expr scope a}))"
    | none => throw s!"unsupported operator {op}"
  | .structLit _ fs => do
    let fs ← fs.mapM fun (k, e) => return s!"({k.quote}, ← {← expr scope e})"
    return s!"(do pure (Val.record [{", ".intercalate fs}]))"
  | .arrayLit es => do
    let es ← es.mapM fun e => return s!"← {← expr scope e}"
    return s!"(do pure (Val.array [{", ".intercalate es}]))"
  | .proj e k => return s!"(do Val.proj (← {← expr scope e}) {k.quote})"
  | .«throw» e => return s!"(do throw (Sig.throw (← {← expr scope e})))"
  | _ => throw "construct outside the Lean core fragment"

/-- The top-level let-chain as the lines of a `do` block -/
partial def doLines (scope : List String) : LeanExpr → Res
  | .«let» x _ v b => return s!"  let {← name x} ← {← expr scope v}\n{← doLines (x :: scope) b}"
  | e => return s!"  {← expr scope e}\n"

/-- A complete Lean file that evaluates `e` and prints the result in the
    format of `JSON.stringify`. -/
def emitModule (e : LeanExpr) : Res := do
  let body ← doLines [] e
  return "import LeanJS.Runtime\n" ++
    "open LeanJS.Runtime LeanJS.IR\n\n" ++
    "/-- Generated by lean-js from the verified core translation. -/\n" ++
    "unsafe def program : R := do\n" ++ body ++ "\n" ++
    "#eval report program\n"

end LeanJS.Lean.EmitExec
