[unverified] outside the verified core (unsupported: class); using the legacy translator
do
  let Animal ← { constructor := fun name => do
    self.name.set name
    name
, speak := fun => return self.name + " makes a noise." }
  let Dog := { constructor := fun name => super name, speak := fun => return self.name + " barks." }
  let d := Dog "Rex"
  console.log d.speak

[exit 0]
