[unverified] outside the verified core (unsupported: assignment); using the legacy translator
do
  let Person := fun name age => do
    self.name.set name
    name
    self.age.set age
    age

  Person.prototype.greet.set (fun => return "Hi, I'm " + self.name)
  fun => return "Hi, I'm " + self.name
  let p ← IO.mkRef (Person "Alice" 30)
  console.log p.get.greet
  let obj ← IO.mkRef { value := fun => return self._value, value := fun v => do
    self._value.set v
    v
 }
  obj.get.value.set 42
  42
  console.log obj.get.value
  let nested ← IO.mkRef { a := { b := { c := 1 } } }
  let c ← IO.mkRef nested.get.a.b.c
  let arr ← IO.mkRef #[#[1, 2], #[3, 4]]
  let first ← IO.mkRef arr.get[0]![1]!
  let x ← IO.mkRef (if typeof p.get == "object" then "yes" else "no")
  let y ← IO.mkRef ()
  let z ← IO.mkRef (!true)
  let w ← IO.mkRef (~~~255)
  x.set (x.get.get + "!")
  while x.get.get.length < 5 do
    x.set (x.get.get + "!")
  let key := ()
  while true do
    key := __nextKey obj.get
    console.log key

[exit 0]
