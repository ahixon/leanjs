[unverified] outside the verified core (unsupported: ++/--); using the legacy translator
do
  let makeCounter := fun => do
    let count ← IO.mkRef 0
    return { increment := fun => do
      count.set (count.get.get + 1)
      count.get.get
, decrement := fun => do
      count.set (count.get.get - 1)
      count.get.get
, getCount := fun => do
      count.get.get
 }

  let counter := makeCounter
  counter.increment
  counter.increment
  console.log counter.getCount
  let compose := fun f g => return fun x => return f (g x)
  let add1 := fun x => x + 1
  let mul2 := fun x => x * 2
  let add1ThenMul2 := compose mul2 add1
  console.log (add1ThenMul2 3)
  let items ← IO.mkRef #[1, 2, 3, 4, 5]
  let i ← IO.mkRef 0
  i.get
  while i.get.get < items.get.length do
    console.log items.get[i.get.get]!
    let __old ← i.get.get
    i.set (i.get.get + 1)
    __old

[exit 0]
